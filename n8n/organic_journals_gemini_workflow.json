        "jsCode": "// Get text from Gemini or OpenAI response\nconst data = $input.first().json;\nconst text = data.text || (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || (data.response && data.response.text) || '';\nconst lines = text.split('\\n').map(line => line.trim().replace(/^[-*\\d.]+\\s*/, '')).filter(line => line.length > 3);\nreturn lines.map(line => ({\n  json: {\n    response: { text: line }\n  }\n}));"
