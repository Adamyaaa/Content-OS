# Groq API Key for Whisper Transcription
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key for Multimodal Video Analysis, Script Generation, and Brand QA
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Server Configuration
PORT=8000
HOST=127.0.0.1

# Supabase Settings (for Trend Queue)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# Content OS API Token (for OpenClaw and n8n authentication)
CONTENT_OS_API_TOKEN=your_secure_api_token
