{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://organic-content-os-backend.onrender.com/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://organic-content-os-backend.onrender.com/data/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
